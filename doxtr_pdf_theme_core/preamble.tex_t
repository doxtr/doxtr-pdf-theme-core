%% Load scrhack to patch float.sty's deprecated \float@addtolists interface.
%% Sphinx's sphinx.sty loads the 'float' package which uses the old interface
%% incompatible with KOMA-Script's tocbasic system.  scrhack provides the
%% compatibility bridge, eliminating the scrbook warning.
\usepackage{scrhack}
\usepackage{calc}
<% if doxtr_landscape_package %>\usepackage{<< doxtr_landscape_package >>}<% endif %>

%% ----------------------------------------------------
%% TABLE CELL OVERFLOW SAFETY NET
%% Ensure etoolbox is available for \AtBeginEnvironment hooks.
%% (Implicitly loaded via tcolorbox, but declared explicitly for robustness.)
%% ----------------------------------------------------
\makeatletter
\@ifpackageloaded{etoolbox}{}{\usepackage{etoolbox}}
\makeatother

%% Allow emergency stretching in table cells to prevent overflow
%% when AST-level processing misses edge cases.
\AtBeginEnvironment{tabulary}{\emergencystretch=1em}
\AtBeginEnvironment{longtable}{\emergencystretch=1em}
\AtBeginEnvironment{tabular}{\emergencystretch=1em}

%% ----------------------------------------------------
%% AUTO-LANDSCAPE ENVIRONMENT (legacy, width-based)
%% Typesets content in a savebox, measures its natural width,
%% and conditionally switches to landscape if > \linewidth.
%% Used by the doxtr-landscape AST processor for auto-detection.
%% Forced landscape uses pdflscape's \begin{landscape} directly.
%% NOTE: This does NOT work for Sphinx tables that use relative
%% \X{a}{b} column widths, since they always fill \linewidth.
%% For those, use doxtradaptivelandscape instead.
%% ----------------------------------------------------
\makeatletter
\newsavebox{\doxtr@landscapebox}
\newenvironment{doxtrautolandscape}{%
  \begin{lrbox}{\doxtr@landscapebox}\begin{minipage}{\linewidth}%
}{%
  \end{minipage}\end{lrbox}%
  \ifdim\wd\doxtr@landscapebox>\linewidth
    \begin{landscape}%
    \centering\usebox{\doxtr@landscapebox}%
    \end{landscape}%
  \else
    \noindent\usebox{\doxtr@landscapebox}%
  \fi
}
\makeatother

%% ----------------------------------------------------
%% ADAPTIVE LANDSCAPE ENVIRONMENT
%% Automatically selects the smallest A-series page size
%% (A4L, A3L, A2L, A1L, A0L, 2A0L, 4A0L, and beyond) that
%% can hold the content with readable column widths.
%%
%% Strategy: compute the required width from column count and a
%% minimum per-column width (doxtr@mincolwidth, default 22mm).
%% Then select the smallest A-series landscape page that provides
%% enough textwidth.  Uses \pdfpagewidth/\pdfpageheight for the
%% physical page and LaTeX environment grouping (\begin/\end)
%% for scoping text dimension changes.  Content is NOT placed in a savebox, so
%% tables that exceed the page height can break across pages.
%%
%% A-series landscape dimensions (width x height):
%%   A4L:  297mm x  210mm  (textwidth ~  267mm with 15mm margins)
%%   A3L:  420mm x  297mm  (textwidth ~  390mm)
%%   A2L:  594mm x  420mm  (textwidth ~  564mm)
%%   A1L:  841mm x  594mm  (textwidth ~  811mm)
%%   A0L: 1189mm x  841mm  (textwidth ~ 1159mm)
%%  2A0L: 1682mm x 1189mm  (textwidth ~ 1652mm)
%%  4A0L: 2378mm x 1682mm  (textwidth ~ 2348mm)
%%
%% Beyond 4A0 the algorithm doubles the shorter dimension to
%% produce arbitrarily large pages (8A0, 16A0, 32A0, ...).
%% ----------------------------------------------------
\makeatletter
%% Engine check: \pdfpagewidth is pdfTeX/LuaTeX only.
\@ifundefined{pdfpagewidth}{%
  \PackageError{doxtr-pdf-theme-core}{%
    The adaptive landscape feature requires pdfTeX or LuaTeX.\MessageBreak
    XeTeX is not supported (use \string\pagewidth\space instead)}{%
    Compile with lualatex or pdflatex.}%
}{}
\newlength{\doxtr@mincolwidth}
%% Minimum per-column width for page-size selection.  22mm accommodates
%% short labels, 3-digit numbers, and typical column headers without
%% overflow.  Adjust in child themes via \setlength{\doxtr@mincolwidth}{...}.
\setlength{\doxtr@mincolwidth}{22mm}
\newlength{\doxtr@requiredwidth}
\newlength{\doxtr@selectedpagewidth}
\newlength{\doxtr@selectedpageheight}
\newlength{\doxtr@selectedtextwidth}
\newlength{\doxtr@marginsize}
%% Margin for landscape pages (each side).  Adjust in child themes via
%% \setlength{\doxtr@marginsize}{...} injected through register_preamble_hook.
\setlength{\doxtr@marginsize}{15mm}
\newcounter{doxtr@colcount}
\newlength{\doxtr@savedpagewidth}
\newlength{\doxtr@savedpageheight}
%% Temporary lengths for the doubling loop
%% NOTE: Requires pdfTeX or LuaTeX (\pdfpagewidth primitive).
%%       Not compatible with XeTeX (which uses \pagewidth instead).
\newlength{\doxtr@tmpW}
\newlength{\doxtr@tmpH}

\newcommand{\doxtr@selectpagesize}{%
  %% Guard: ensure mincolwidth is positive to prevent infinite loops.
  %% Falls back to the same initial default (\setlength{\doxtr@mincolwidth}{22mm}).
  \ifdim\doxtr@mincolwidth<1pt\relax
    \setlength{\doxtr@mincolwidth}{22mm}%
  \fi
  %% Compute required text width from column count
  \setlength{\doxtr@requiredwidth}{\value{doxtr@colcount}\doxtr@mincolwidth}%
  %% Default: A4 landscape
  \setlength{\doxtr@selectedpagewidth}{297mm}%
  \setlength{\doxtr@selectedpageheight}{210mm}%
  \setlength{\doxtr@selectedtextwidth}{\dimexpr 297mm-2\doxtr@marginsize\relax}%
  %% Step up through fixed A-series sizes.
  %% Textwidth is always pagewidth - 2*margin (single source of truth).
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% A3 landscape
    \setlength{\doxtr@selectedpagewidth}{420mm}%
    \setlength{\doxtr@selectedpageheight}{297mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 420mm-2\doxtr@marginsize\relax}%
  \fi
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% A2 landscape
    \setlength{\doxtr@selectedpagewidth}{594mm}%
    \setlength{\doxtr@selectedpageheight}{420mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 594mm-2\doxtr@marginsize\relax}%
  \fi
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% A1 landscape
    \setlength{\doxtr@selectedpagewidth}{841mm}%
    \setlength{\doxtr@selectedpageheight}{594mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 841mm-2\doxtr@marginsize\relax}%
  \fi
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% A0 landscape
    \setlength{\doxtr@selectedpagewidth}{1189mm}%
    \setlength{\doxtr@selectedpageheight}{841mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 1189mm-2\doxtr@marginsize\relax}%
  \fi
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% 2A0 landscape (1682 x 1189mm)
    \setlength{\doxtr@selectedpagewidth}{1682mm}%
    \setlength{\doxtr@selectedpageheight}{1189mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 1682mm-2\doxtr@marginsize\relax}%
  \fi
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    %% 4A0 landscape (2378 x 1682mm)
    \setlength{\doxtr@selectedpagewidth}{2378mm}%
    \setlength{\doxtr@selectedpageheight}{1682mm}%
    \setlength{\doxtr@selectedtextwidth}{\dimexpr 2378mm-2\doxtr@marginsize\relax}%
  \fi
  %% Beyond 4A0: keep doubling the shorter side (landscape orientation)
  %% until the textwidth accommodates the required width.
  %% Each iteration: new_width = old_height * 2, new_height = old_width
  %% (rotated doubling preserving A-series aspect ratio).
  \ifdim\doxtr@requiredwidth>\doxtr@selectedtextwidth\relax
    \setlength{\doxtr@tmpW}{\doxtr@selectedpagewidth}%
    \setlength{\doxtr@tmpH}{\doxtr@selectedpageheight}%
    \@whiledim\doxtr@requiredwidth>\doxtr@selectedtextwidth\do{%
      %% Double: new page width = 2 * current height
      %%         new page height = current width
      \setlength{\doxtr@selectedpageheight}{\doxtr@tmpW}%
      \setlength{\doxtr@selectedpagewidth}{2\doxtr@tmpH}%
      %% Update temps for next iteration
      \setlength{\doxtr@tmpW}{\doxtr@selectedpagewidth}%
      \setlength{\doxtr@tmpH}{\doxtr@selectedpageheight}%
      %% Textwidth = pagewidth - 2*margin
      \setlength{\doxtr@selectedtextwidth}{\dimexpr\doxtr@selectedpagewidth-2\doxtr@marginsize\relax}%
    }%
  \fi
}

%% The adaptive landscape environment uses a plain \newenvironment
%% (NOT \NewEnviron from the environ package) because longtable
%% manipulates the output routine and is incompatible with token-list
%% body capture.  Content flows directly between \begin and \end,
%% allowing longtable page breaks to work naturally.
%%
%% NOTE: The column count argument must be given as [N] (optional arg).
%% The \begin part sets dimensions; \end part restores them.
\newlength{\doxtr@saved@textwidth}
\newlength{\doxtr@saved@textheight}
\newlength{\doxtr@saved@oddsidemargin}
\newlength{\doxtr@saved@evensidemargin}
\newlength{\doxtr@saved@topmargin}
\newlength{\doxtr@saved@headheight}
\newlength{\doxtr@saved@headsep}
\newlength{\doxtr@saved@topskip}

%% Deferred pagegoal resynchronization command.
%% Called via \aftergroup at the end of doxtradaptivelandscape so that
%% it executes after the environment's implicit group has fully closed.
%% This ensures that TeX's output routine and tcolorbox's breakable
%% algorithm see the correct \pagegoal on the first page after a
%% landscape-to-portrait transition.
%%
%% Without this, \pagegoal may retain a stale value from the landscape
%% geometry, causing breakable tcolorboxes (e.g. sphinx-needs cards) to
%% overestimate available vertical space and overflow into the footer.
\newcommand{\doxtr@resync@pagegoal}{%
  %% \@colht is the canonical "full column height" that the output
  %% routine uses to initialize \pagegoal at the top of each page.
  %% Setting it and \vsize here ensures consistency even if the output
  %% routine has not yet fired for the current page.
  \global\@colht=\textheight\relax
  \global\vsize=\textheight\relax
  %% If we are at the top of a fresh page (\pagetotal near zero),
  %% explicitly set \pagegoal so tcolorbox sees correct available space.
  %% Otherwise, delegate to \doxtr@cap@breakable@pagegoal for the
  %% unconditional cap when \pagegoal exceeds \textheight (which can
  %% happen when the output routine re-derives \pagegoal from a stale
  %% \vsize on subsequent page breaks).
  %% See also: \doxtr@cap@breakable@pagegoal (defined below).
  \ifdim\pagetotal<1pt\relax
    \pagegoal=\textheight\relax
  \else
    \doxtr@cap@breakable@pagegoal
  \fi
}

%% ----------------------------------------------------
%% BREAKABLE TCOLORBOX PAGEGOAL CAP (defense-in-depth)
%% Called at the start of every breakable tcolorbox router/environment
%% to ensure \pagegoal does not exceed \textheight.  This guards
%% against any desync between \vsize and \textheight that the
%% root-cause fix (\AtBeginDocument vsize sync) or the landscape
%% resync (\doxtr@resync@pagegoal) may not have caught, e.g.
%% because a child theme or user code mutated geometry after
%% document start.  Without this, tcolorbox's breakable algorithm
%% overestimates available vertical space and overflows into the
%% footer.  The guard is intentionally cheap (single \ifdim).
%%
%% Also invoked from \doxtr@resync@pagegoal (above) as the
%% fallback branch when \pagetotal >= 1pt.
%%
%% \doxtrcapbreakablepagegoal is the public-facing wrapper for use
%% in document body context (AST processor raw nodes) where @ is
%% not a letter.  It delegates to the @-form so that child themes
%% can override the behavior by redefining a single command.
%% Internal code (preamble, routers) should use the @-form
%% \doxtr@cap@breakable@pagegoal directly.
%% ----------------------------------------------------
<% if doxtr_pagegoal_overflow_guard %>
\newcommand{\doxtr@cap@breakable@pagegoal}{%
  \ifdim\pagegoal>\textheight\relax
    \pagegoal=\textheight\relax
    \global\@colht=\textheight\relax
    \global\vsize=\textheight\relax
  \fi
}
<% else %>
\newcommand{\doxtr@cap@breakable@pagegoal}{}
<% endif %>
\newcommand{\doxtrcapbreakablepagegoal}{\doxtr@cap@breakable@pagegoal}

\newenvironment{doxtradaptivelandscape}[1][0]{%
  %% #1 = column count (passed from the AST processor)
  \setcounter{doxtr@colcount}{#1}%
  \doxtr@selectpagesize
  %% Save ALL current dimensions for explicit restoration
  \setlength{\doxtr@savedpagewidth}{\pdfpagewidth}%
  \setlength{\doxtr@savedpageheight}{\pdfpageheight}%
  \setlength{\doxtr@saved@textwidth}{\textwidth}%
  \setlength{\doxtr@saved@textheight}{\textheight}%
  \setlength{\doxtr@saved@oddsidemargin}{\oddsidemargin}%
  \setlength{\doxtr@saved@evensidemargin}{\evensidemargin}%
  \setlength{\doxtr@saved@topmargin}{\topmargin}%
  \setlength{\doxtr@saved@headheight}{\headheight}%
  \setlength{\doxtr@saved@headsep}{\headsep}%
  \setlength{\doxtr@saved@topskip}{\topskip}%
  %% Flush pending content to the current page
  \clearpage
  %% Set physical PDF page size (global so the output routine
  %% and KOMA-Script's layer system see correct values on every
  %% continuation page, not just the first one).
  \global\pdfpagewidth=\doxtr@selectedpagewidth\relax
  \global\pdfpageheight=\doxtr@selectedpageheight\relax
  %% Also update \paperwidth/\paperheight so TikZ's "current page"
  %% node reflects the actual physical page dimensions.  Without this,
  %% TikZ overlays (e.g. draft watermark) use stale portrait dimensions
  %% and render nodes outside the visible page area.
  \global\paperwidth=\doxtr@selectedpagewidth\relax
  \global\paperheight=\doxtr@selectedpageheight\relax
  %% Adjust text area dimensions for the new page.
  %% All assignments are \global to prevent scoping issues: the
  %% output routine re-reads these when shipping each page, and
  %% KOMA-Script's scrlayer may cache dimensions globally.  Local
  %% assignments are invisible to these subsystems.
  \global\textwidth=\doxtr@selectedtextwidth\relax
  \global\linewidth=\doxtr@selectedtextwidth\relax
  \global\hsize=\doxtr@selectedtextwidth\relax
  \global\columnwidth=\doxtr@selectedtextwidth\relax
  \global\textheight=\dimexpr\doxtr@selectedpageheight-2\doxtr@marginsize\relax
  %% Sync \vsize and \@colht so the output routine (and longtable's
  %% page-break calculations via \pagegoal) respect the reduced page
  %% height on ALL continuation pages, not just the first.
  \global\@colht=\textheight\relax
  \global\vsize=\textheight\relax
  %% Adjust margins (TeX origin is 1in from each edge)
  \global\headheight=0pt\relax
  \global\headsep=0pt\relax
  \global\topmargin=\dimexpr\doxtr@marginsize-1in\relax
  \global\oddsidemargin=\dimexpr\doxtr@marginsize-1in\relax
  \global\evensidemargin=\dimexpr\doxtr@marginsize-1in\relax
  \global\topskip=0pt\relax
  \pagestyle{empty}%
  \noindent
}{%
  %% End part: flush oversized page(s), then restore all dimensions.
  %% All assignments are \global to match the begin part — the output
  %% routine and KOMA-Script must see the restored portrait values
  %% immediately after the landscape section ends.
  \par\clearpage
  \pagestyle{scrheadings}%
  \global\pdfpagewidth=\doxtr@savedpagewidth\relax
  \global\pdfpageheight=\doxtr@savedpageheight\relax
  \global\paperwidth=\doxtr@savedpagewidth\relax
  \global\paperheight=\doxtr@savedpageheight\relax
  \global\textwidth=\doxtr@saved@textwidth\relax
  \global\linewidth=\doxtr@saved@textwidth\relax
  \global\hsize=\doxtr@saved@textwidth\relax
  \global\columnwidth=\doxtr@saved@textwidth\relax
  \global\textheight=\doxtr@saved@textheight\relax
  %% Restore \vsize and \@colht so subsequent pages resume correct
  %% page-break behaviour with portrait dimensions.
  \global\@colht=\doxtr@saved@textheight\relax
  \global\vsize=\doxtr@saved@textheight\relax
  \global\oddsidemargin=\doxtr@saved@oddsidemargin\relax
  \global\evensidemargin=\doxtr@saved@evensidemargin\relax
  \global\topmargin=\doxtr@saved@topmargin\relax
  \global\headheight=\doxtr@saved@headheight\relax
  \global\headsep=\doxtr@saved@headsep\relax
  \global\topskip=\doxtr@saved@topskip\relax
  %% AFTERGROUP PAGEGOAL SYNCHRONIZATION (Option C)
  %% After the environment group closes, TeX resumes typesetting on a
  %% fresh page. However, the output routine may have cached a stale
  %% \pagegoal from the landscape geometry. tcolorbox's breakable
  %% algorithm queries \pagegoal - \pagetotal to decide whether to
  %% break; a stale value can cause it to overestimate available space,
  %% resulting in content overflowing into the footer.
  %%
  %% \aftergroup defers the resync until after the environment's
  %% implicit group closes, ensuring the output routine's state is
  %% updated in the correct context for subsequent content.
  \aftergroup\doxtr@resync@pagegoal
}

%% ----------------------------------------------------
%% LANDSCAPE DETECTION UTILITY
%% Reusable command for templates that need to branch on page
%% orientation.  Compares physical PDF page dimensions at the
%% point of use (works correctly inside shipout hooks).
%%   \doxtriflandscape{<landscape code>}{<portrait code>}
%% Child themes can redefine this via register_preamble_hook.
%% ----------------------------------------------------
\newcommand{\doxtriflandscape}[2]{%
  \ifdim\pdfpagewidth>\pdfpageheight #1\else #2\fi
}
\makeatother

%% ----------------------------------------------------
%% RESOLVE SPHINX vs KOMA-SCRIPT CONFLICT
%% Sphinx hardcodes fancyhdr and titlesec. We undefine 
%% their macros so scrlayer-scrpage can safely load!
%% ----------------------------------------------------
\let\lhead\undefined
\let\chead\undefined
\let\rhead\undefined
\let\lfoot\undefined
\let\cfoot\undefined
\let\rfoot\undefined
\let\newpagestyle\undefined
\let\renewpagestyle\undefined

\usepackage[automark]{scrlayer-scrpage}
\usepackage{tikz}
\usetikzlibrary{calc}
\usepackage{tcolorbox}
\tcbuselibrary{skins, hooks, breakable}
\usepackage{varwidth}
<% if doxtr_suppress_warnings %>
%% --- Warning suppression (doxtr_suppress_warnings = True) ---
%% Suppress varwidth "Failed to reprocess" warnings.
%% All doxtr varwidth usage is inside TikZ nodes where the two-pass
%% algorithm always fails (TikZ captures content specially), but output
%% is correct since varwidth falls back to the first-pass result.
\usepackage{silence}
\WarningFilter{varwidth}{Failed to reprocess}
%% Defensive: the split RedeclareSectionCommands (line ~870) fixes the root cause,
%% but this filter catches edge cases from child themes that may re-add tocdynindent.
\WarningFilter{tocbasic}{dynindent}
%% Safety net for user-configured footheight values that are too small for their
%% footer content (logo + page number). The 30pt core default should suffice.
\WarningFilter{scrlayer-scrpage}{footheight to low}
%% Suppress undefined font shape warnings (e.g. TU/Rye(0)/b/n, TU/Alice(0)/b/n).
%% Display fonts (Rye, Alice, Kranky, StoryScript, etc.) ship only Regular weight.
%% KOMA-Script headings and tcolorbox titles apply \bfseries internally; LaTeX
%% falls back to Regular, which is the intended visual for decorative fonts.
\WarningFilter{latexfont}{Font shape}
%% Suppress overfull/underfull hbox and vbox messages globally.
%% These are unavoidable in large auto-generated documents with tables,
%% code blocks, and long URLs.  The output is still correct.
%% Global settings suppress underfull reporting:
\hbadness=10000
\vbadness=10000
\hfuzz=\maxdimen
\vfuzz=\maxdimen
%% For LuaTeX: use hpack_quality/vpack_quality callbacks to suppress overfull
%% warnings from ALL scopes (including inner groups like tcolorbox/longtable
%% that reset \hfuzz).  Returning nil from the callback suppresses the message.
%% Theme authors can remove these filters via:
%%   \directlua{luatexbase.remove_from_callback('hpack_quality', 'doxtr.suppress_hbox_warnings')}
%%   \directlua{luatexbase.remove_from_callback('vpack_quality', 'doxtr.suppress_vbox_warnings')}
\directlua{
  luatexbase.add_to_callback('hpack_quality', function(incident, detail, head, first, last)
    return nil
  end, 'doxtr.suppress_hbox_warnings')
  luatexbase.add_to_callback('vpack_quality', function(incident, detail, head, first, last)
    return nil
  end, 'doxtr.suppress_vbox_warnings')
}
<% endif %>
\usepackage{xpatch}
% Load the relsize package to enable decimal scaling used in doxtr_containers themes
% Let's us use: r'\relscale{1.2}' to scale fonts
\usepackage{relsize}

%% --- Container Render Mode: environment mode support ---
%% Boolean flag for conditional title rendering in environment-mode containers.
%% Templates use \ifddContainerHasTitle for robust empty-checking.
\newif\ifddContainerHasTitle
\ddContainerHasTitlefalse

%% ----------------------------------------------------
%% MICROTYPE — Typographic refinement
%% Only enabled when draft mode is OFF (production builds).
%% Draft mode = fast iteration; microtype = typographic polish.
%% ----------------------------------------------------
<% if doxtr_microtype_enabled %>
\usepackage[
  protrusion=<% if doxtr_microtype_protrusion %>true<% else %>false<% endif %>,
  expansion=<% if doxtr_microtype_expansion %>true<% else %>false<% endif %>,
  kerning=<% if doxtr_microtype_kerning %>true<% else %>false<% endif %>,
  stretch=<< doxtr_microtype_stretch >>,
  shrink=<< doxtr_microtype_shrink >>
]{microtype}
<% endif %>

%% Document Geometry and Header/Footer Heights
<% if doxtr_headsep or doxtr_footskip %>
\geometry{<% if doxtr_headsep %>headsep=<< doxtr_headsep >><% endif %><% if doxtr_headsep and doxtr_footskip %>, <% endif %><% if doxtr_footskip %>footskip=<< doxtr_footskip >><% endif %>}
<% endif %>
<% if doxtr_headheight or doxtr_footheight %>
\KOMAoptions{<% if doxtr_headheight %>headheight=<< doxtr_headheight >><% endif %><% if doxtr_headheight and doxtr_footheight %>, <% endif %><% if doxtr_footheight %>footheight=<< doxtr_footheight >><% endif %>}
<% endif %>

%% ----------------------------------------------------
%% VSIZE / TEXTHEIGHT SYNCHRONIZATION
%% KOMAoptions (above) may recalculate \textheight via typearea when
%% headheight or footheight is changed.  However, \activateareas
%% (which syncs \vsize = \textheight) only runs when \@atdocument
%% is true, i.e. inside \begin{document}.  Because KOMAoptions is
%% called in the preamble, \vsize retains its original (stale) value.
%% tcolorbox's breakable algorithm derives available space from
%% \pagegoal, which TeX sets from \vsize at the top of each page.
%% A stale \vsize that exceeds \textheight causes breakable boxes
%% to overestimate available space and overflow into the footer.
%% This hook syncs all three output-routine registers at document
%% start so every page begins with the correct \pagegoal.
%% ----------------------------------------------------
<% if doxtr_pagegoal_overflow_guard %>
\makeatletter
\AtBeginDocument{%
  \global\vsize=\textheight\relax
  \global\@colht=\textheight\relax
  \global\@colroom=\textheight\relax
}
\makeatother
<% endif %>

\clearpairofpagestyles
\ohead{\headmark}
%% Starred commands mirror each other perfectly on both plain and scrheadings styles
\ofoot*{\pagemark}

%% --- Page Background and Body Text Color ---
%% Always emit pagecolor/textcolor for structural consistency between light
%% and dark mode builds (prevents page-count drift from whatsit node differences).
%% In light mode: white page (#FFFFFF) + black text (#000000).
%% In dark mode: inverted page + light text.
<% if doxtr_emit_pagecolor %>
\definecolor{ddpagebackground}{rgb}{<< doxtr_page_bg_cmyk >>}
\definecolor{ddbodytextcolor}{rgb}{<< doxtr_body_text_color_cmyk >>}
\pagecolor{ddpagebackground}
\color{ddbodytextcolor}
\AtBeginDocument{\color{ddbodytextcolor}}
<% endif %>
<% if doxtr_footer_logo %>
\ifoot*{\includegraphics[height=<< doxtr_footer_logo_height >>, keepaspectratio]{<< doxtr_footer_logo >>}}
<% endif %>
\pagestyle{scrheadings}

%%% Draft Watermark
<< doxtr_rendered_draft >>

%%% Epigraph / Dictum Configuration Styles
\makeatletter
<% for level in ['epigraph', 'part_epigraph', 'chapter_epigraph', 'section_epigraph', 'subsection_epigraph', 'subsubsection_epigraph'] %>
<% if v['doxtr_' ~ level ~ '_color'] %>\definecolor{dd<< level | replace('_', '') >>color}{rgb}{<< v['doxtr_' ~ level ~ '_color'] >>}<% endif %>
<% if v['doxtr_' ~ level ~ '_author_color'] %>\definecolor{dd<< level | replace('_', '') >>authorcolor}{rgb}{<< v['doxtr_' ~ level ~ '_author_color'] >>}<% endif %>

<% set macro_name = 'generic' if level == 'epigraph' else level | replace('_epigraph', '') %>
\expandafter\def\csname ddepigraph@<< macro_name >>\endcsname{%
  \renewcommand*{\dictumwidth}{<< v['doxtr_' ~ level ~ '_width'] >>}%
  \renewcommand*{\dictumauthorformat}[1]{<< v['doxtr_' ~ level ~ '_format'] >>}%
  \renewcommand*{\raggeddictum}{<< v['doxtr_' ~ level ~ '_align_box'] >>}%
  \renewcommand*{\raggeddictumtext}{<< v['doxtr_' ~ level ~ '_align_text'] >>}%
  \renewcommand*{\raggeddictumauthor}{<< v['doxtr_' ~ level ~ '_align_author'] >>}%
  \setkomafont{dictumtext}{<% if v['doxtr_' ~ level ~ '_color'] %>\color{dd<< level | replace('_', '') >>color}<% endif %><% if v['doxtr_' ~ level ~ '_size'] %><< v['doxtr_' ~ level ~ '_size'] >><% endif %><% if v['doxtr_' ~ level ~ '_font'] %>\fontspec{<< v['doxtr_' ~ level ~ '_font'] >>}<% endif %>}%
  \setkomafont{dictumauthor}{<% if v['doxtr_' ~ level ~ '_author_color'] %>\color{dd<< level | replace('_', '') >>authorcolor}<% endif %><% if v['doxtr_' ~ level ~ '_author_size'] %><< v['doxtr_' ~ level ~ '_author_size'] >><% endif %><% if v['doxtr_' ~ level ~ '_author_font'] %>\fontspec{<< v['doxtr_' ~ level ~ '_author_font'] >>}<% endif %>}%
}
<% endfor %>

<% for p_num, bg_conf in doxtr_part_backgrounds.items() %>
  <% if bg_conf.epigraph_color_cmyk %>\definecolor{ddpartepigraph<< p_num >>color}{rgb}{<< bg_conf.epigraph_color_cmyk >>}<% endif %>
  <% if bg_conf.epigraph_author_color_cmyk %>\definecolor{ddpartepigraphauthor<< p_num >>color}{rgb}{<< bg_conf.epigraph_author_color_cmyk >>}<% endif %>
  \expandafter\def\csname ddepigraph@part@<< p_num >>\endcsname{%
    <% if bg_conf.epigraph_color_cmyk %>\addtokomafont{dictumtext}{\color{ddpartepigraph<< p_num >>color}}<% endif %>
    <% if bg_conf.epigraph_author_color_cmyk %>\addtokomafont{dictumauthor}{\color{ddpartepigraphauthor<< p_num >>color}}<% endif %>
  }
<% endfor %>

\newcommand{\setupddepigraph}[1]{%
  \csname ddepigraph@#1\endcsname
  \ifstr{#1}{part}{%
    % Inside the preamble text, the part counter has already been incremented!
    \csname ddepigraph@part@\the\value{part}\endcsname
  }{}%
}
\makeatother

%%% Title Page Injection
<< doxtr_rendered_title_page >>

%% Part Background Image/Color Injection
<% if doxtr_part_backgrounds %>
%% Pre-define colors to prevent pgfkeys errors
<% for part_num, bg_conf in doxtr_part_backgrounds.items() %>
  <% if bg_conf.background_color_cmyk %>\definecolor{ddpartbg<< part_num >>}{rgb}{<< bg_conf.background_color_cmyk >>}<% endif %>
  <% if bg_conf.font_color_cmyk %>\definecolor{ddpart<< part_num >>color}{rgb}{<< bg_conf.font_color_cmyk >>}<% endif %>
  <% if bg_conf.number_color_cmyk %>\definecolor{ddpart<< part_num >>numbercolor}{rgb}{<< bg_conf.number_color_cmyk >>}<% endif %>
  <% if bg_conf.number_part_color_cmyk %>\definecolor{ddpart<< part_num >>numberpartcolor}{rgb}{<< bg_conf.number_part_color_cmyk >>}<% endif %>
  <% if bg_conf.number_number_color_cmyk %>\definecolor{ddpart<< part_num >>numbernumbercolor}{rgb}{<< bg_conf.number_number_color_cmyk >>}<% endif %>
<% endfor %>
<% endif %>

%% Define the Global KOMA Hooks for Part Strings
<% if doxtr_appendix_start_part %>
\makeatletter
\newcounter{ddPartCounter}
\setcounter{ddPartCounter}{1}
\xpretocmd{\part}{%
  \ifnum\value{ddPartCounter}=<< doxtr_appendix_start_part >>\relax
    \appendix
    \setcounter{part}{0}% Reset part counter so it natively steps directly to A (1)
    \renewcommand\thepart{\Alph{part}}%
    \providecommand\theHpart{\Alph{part}}%
    \renewcommand\theHpart{\Alph{part}}% <--- FIX FOR HYPERREF LINKS
    <% if doxtr_appendix_chapter_numbering %>
      \renewcommand\thechapter{\thepart.\arabic{chapter}}%
      \providecommand\theHchapter{\thepart.\arabic{chapter}}%
      \renewcommand\theHchapter{\thepart.\arabic{chapter}}% <--- FIX FOR HYPERREF LINKS
    <% else %>
      \setcounter{secnumdepth}{-1}% Hard-disable Sphinx's nested numbering engine
    <% endif %>
  \fi
  \stepcounter{ddPartCounter}%
}{}{}
\makeatother
<% endif %>

\makeatletter
\AtBeginDocument{
  % Ensure literalblock lists (.lol) are opened for writing at the beginning of the document
  \@ifundefined{addtotoclist}{}{\addtotoclist{lol}}
  
  % Patch Sphinx's index to use \addchap so it natively renders without numbers
  \@ifundefined{theindex}{}{\xpatchcmd{\theindex}{\@makeschapterhead}{\addchap}{}{}}

  % Force standard chapter-level numbering for Figures and Tables natively in LaTeX
  \@ifundefined{c@chapter}{}{
      \@ifundefined{counterwithin}{\usepackage{chngcntr}}{}
      \counterwithin{figure}{chapter}
      \counterwithin{table}{chapter}
  }
}
\makeatother

\newcommand{\ddpartcolorcmd}{<% if doxtr_part_color %>\color{ddpartcolor}<% endif %>}
\newcommand{\ddpartsizecmd}{<% if doxtr_part_size %> << doxtr_part_size >><% endif %>}
\newcommand{\ddpartfontcmd}{<% if doxtr_part_font %> \fontspec{<< doxtr_part_font >>}<% endif %>}
\addtokomafont{part}{\ddpartcolorcmd\ddpartsizecmd\ddpartfontcmd}

\newcommand{\ddpartnumbercolorcmd}{<% if doxtr_part_number_color %>\color{ddpartnumbercolor}<% endif %>}
\newcommand{\ddpartnumbersizecmd}{<% if doxtr_part_number_size %> << doxtr_part_number_size >><% endif %>}
\newcommand{\ddpartnumberfontcmd}{<% if doxtr_part_number_font %> \fontspec{<< doxtr_part_number_font >>}<% endif %>}
\addtokomafont{partnumber}{\ddpartnumbercolorcmd\ddpartnumbersizecmd\ddpartnumberfontcmd}

\newkomafont{partnumberpart}{}
\newcommand{\ddpartnumberpartcolorcmd}{<% if doxtr_part_number_part_color %>\color{ddpartnumberpartcolor}<% endif %>}
\newcommand{\ddpartnumberpartsizecmd}{<% if doxtr_part_number_part_size %> << doxtr_part_number_part_size >><% endif %>}
\newcommand{\ddpartnumberpartfontcmd}{<% if doxtr_part_number_part_font %> \fontspec{<< doxtr_part_number_part_font >>}<% endif %>}
\addtokomafont{partnumberpart}{\ddpartnumberpartcolorcmd\ddpartnumberpartsizecmd\ddpartnumberpartfontcmd}

\newkomafont{partnumbernumber}{}
\newcommand{\ddpartnumbernumbercolorcmd}{<% if doxtr_part_number_number_color %>\color{ddpartnumbernumbercolor}<% endif %>}
\newcommand{\ddpartnumbernumbersizecmd}{<% if doxtr_part_number_number_size %> << doxtr_part_number_number_size >><% endif %>}
\newcommand{\ddpartnumbernumberfontcmd}{<% if doxtr_part_number_number_font %> \fontspec{<< doxtr_part_number_number_font >>}<% endif %>}
\addtokomafont{partnumbernumber}{\ddpartnumbernumbercolorcmd\ddpartnumbernumbersizecmd\ddpartnumbernumberfontcmd}

\makeatletter
\renewcommand*{\partheadstartvskip}{%
  \thispagestyle{empty}% Force removal of headers/footers on Part pages
  \edef\curpart{\the\numexpr\value{part}+1\relax}% Fix the off-by-one counter bug
  
  % Reset dynamic part text variables to global defaults
  \renewcommand{\ddpartcolorcmd}{<% if doxtr_part_color %>\color{ddpartcolor}<% endif %>}%
  \renewcommand{\ddpartsizecmd}{<% if doxtr_part_size %> << doxtr_part_size >><% endif %>}%
  \renewcommand{\ddpartfontcmd}{<% if doxtr_part_font %> \fontspec{<< doxtr_part_font >>}<% endif %>}%
  
  \renewcommand{\ddpartnumbercolorcmd}{<% if doxtr_part_number_color %>\color{ddpartnumbercolor}<% endif %>}%
  \renewcommand{\ddpartnumbersizecmd}{<% if doxtr_part_number_size %> << doxtr_part_number_size >><% endif %>}%
  \renewcommand{\ddpartnumberfontcmd}{<% if doxtr_part_number_font %> \fontspec{<< doxtr_part_number_font >>}<% endif %>}%
  
  \renewcommand{\ddpartnumberpartcolorcmd}{<% if doxtr_part_number_part_color %>\color{ddpartnumberpartcolor}<% endif %>}%
  \renewcommand{\ddpartnumberpartsizecmd}{<% if doxtr_part_number_part_size %> << doxtr_part_number_part_size >><% endif %>}%
  \renewcommand{\ddpartnumberpartfontcmd}{<% if doxtr_part_number_part_font %> \fontspec{<< doxtr_part_number_part_font >>}<% endif %>}%
  
  \renewcommand{\ddpartnumbernumbercolorcmd}{<% if doxtr_part_number_number_color %>\color{ddpartnumbernumbercolor}<% endif %>}%
  \renewcommand{\ddpartnumbernumbersizecmd}{<% if doxtr_part_number_number_size %> << doxtr_part_number_number_size >><% endif %>}%
  \renewcommand{\ddpartnumbernumberfontcmd}{<% if doxtr_part_number_number_font %> \fontspec{<< doxtr_part_number_number_font >>}<% endif %>}%
  
<% if doxtr_part_backgrounds %>
  % Apply specific part text property overrides
  <% for part_num, bg_conf in doxtr_part_backgrounds.items() %>
  \ifnum\curpart=<< part_num >>\relax
    <% if bg_conf.font_color_cmyk %>\renewcommand{\ddpartcolorcmd}{\color{ddpart<< part_num >>color}}<% endif %>
    <% if bg_conf.font %>\renewcommand{\ddpartfontcmd}{ \fontspec{<< bg_conf.font >>}}<% endif %>
    <% if bg_conf.size %>\renewcommand{\ddpartsizecmd}{ << bg_conf.size >>}<% endif %>
    
    <% if bg_conf.number_color_cmyk %>\renewcommand{\ddpartnumbercolorcmd}{\color{ddpart<< part_num >>numbercolor}}<% endif %>
    <% if bg_conf.number_font %>\renewcommand{\ddpartnumberfontcmd}{ \fontspec{<< bg_conf.number_font >>}}<% endif %>
    <% if bg_conf.number_size %>\renewcommand{\ddpartnumbersizecmd}{ << bg_conf.number_size >>}<% endif %>
    
    <% if bg_conf.number_part_color_cmyk %>\renewcommand{\ddpartnumberpartcolorcmd}{\color{ddpart<< part_num >>numberpartcolor}}<% endif %>
    <% if bg_conf.number_part_font %>\renewcommand{\ddpartnumberpartfontcmd}{ \fontspec{<< bg_conf.number_part_font >>}}<% endif %>
    <% if bg_conf.number_part_size %>\renewcommand{\ddpartnumberpartsizecmd}{ << bg_conf.number_part_size >>}<% endif %>
    
    <% if bg_conf.number_number_color_cmyk %>\renewcommand{\ddpartnumbernumbercolorcmd}{\color{ddpart<< part_num >>numbernumbercolor}}<% endif %>
    <% if bg_conf.number_number_font %>\renewcommand{\ddpartnumbernumberfontcmd}{ \fontspec{<< bg_conf.number_number_font >>}}<% endif %>
    <% if bg_conf.number_number_size %>\renewcommand{\ddpartnumbernumbersizecmd}{ << bg_conf.number_number_size >>}<% endif %>
  \fi
  <% endfor %>

  \begin{tikzpicture}[remember picture, overlay]
    <% for part_num, bg_conf in doxtr_part_backgrounds.items() %>
    \ifnum\curpart=<< part_num >>\relax
      <% if bg_conf.image %>
      \node[inner sep=0pt, anchor=center] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{<< bg_conf.image >>}};
      <% endif %>
      <% if bg_conf.background_color_cmyk %>
      \fill[ddpartbg<< part_num >>, opacity=<< bg_conf.opacity >>] (current page.south west) rectangle (current page.north east);
      <% endif %>
    \fi
    <% endfor %>
  \end{tikzpicture}%
<% endif %>
  \null\vskip\z@\@plus 1fil\relax
}
\makeatother

%% Define Universal Element Colors
<% if doxtr_title_color %>\definecolor{ddtitlecolor}{rgb}{<< doxtr_title_color >>}<% endif %>
<% if doxtr_subtitle_color %>\definecolor{ddsubtitlecolor}{rgb}{<< doxtr_subtitle_color >>}<% endif %>
<% if doxtr_author_color %>\definecolor{ddauthorcolor}{rgb}{<< doxtr_author_color >>}<% endif %>
<% if doxtr_date_color %>\definecolor{dddatecolor}{rgb}{<< doxtr_date_color >>}<% endif %>
<% if doxtr_release_version_color %>\definecolor{ddreleaseversioncolor}{rgb}{<< doxtr_release_version_color >>}<% endif %>
<% if doxtr_part_color %>\definecolor{ddpartcolor}{rgb}{<< doxtr_part_color >>}<% endif %>
<% if doxtr_chapter_color %>\definecolor{ddchaptercolor}{rgb}{<< doxtr_chapter_color >>}<% endif %>
<% if doxtr_section_color %>\definecolor{ddsectioncolor}{rgb}{<< doxtr_section_color >>}<% endif %>
<% if doxtr_subsection_color %>\definecolor{ddsubsectioncolor}{rgb}{<< doxtr_subsection_color >>}<% endif %>
<% if doxtr_subsubsection_color %>\definecolor{ddsubsubsectioncolor}{rgb}{<< doxtr_subsubsection_color >>}<% endif %>
<% if doxtr_rubric_color %>\definecolor{ddrubriccolor}{rgb}{<< doxtr_rubric_color >>}<% endif %>
<% if doxtr_epigraph_color %>\definecolor{ddepigraphcolor}{rgb}{<< doxtr_epigraph_color >>}<% endif %>
<% if doxtr_epigraph_author_color %>\definecolor{ddepigraphauthorcolor}{rgb}{<< doxtr_epigraph_author_color >>}<% endif %>

%% ----------------------------------------------------
%% SAFE FALLBACK COLOR INHERITANCE
%% ----------------------------------------------------
<% if doxtr_part_number_color %>\definecolor{ddpartnumbercolor}{rgb}{<< doxtr_part_number_color >>}<% else %>\definecolor{ddpartnumbercolor}{rgb}{0, 0, 0, 1}<% endif %>
<% if doxtr_part_number_part_color %>\definecolor{ddpartnumberpartcolor}{rgb}{<< doxtr_part_number_part_color >>}<% else %>\colorlet{ddpartnumberpartcolor}{ddpartnumbercolor}<% endif %>
<% if doxtr_part_number_number_color %>\definecolor{ddpartnumbernumbercolor}{rgb}{<< doxtr_part_number_number_color >>}<% else %>\colorlet{ddpartnumbernumbercolor}{ddpartnumbercolor}<% endif %>

<% if doxtr_chapter_number_color %>\definecolor{ddchapternumbercolor}{rgb}{<< doxtr_chapter_number_color >>}<% else %>\colorlet{ddchapternumbercolor}{ddpartnumbercolor}<% endif %>
<% if doxtr_chapter_line_color %>\definecolor{ddchapterlinecolor}{rgb}{<< doxtr_chapter_line_color >>}<% else %>\colorlet{ddchapterlinecolor}{ddchapternumbercolor!45}<% endif %>

<% if doxtr_section_number_color %>\definecolor{ddsectionnumbercolor}{rgb}{<< doxtr_section_number_color >>}<% else %>\colorlet{ddsectionnumbercolor}{ddchapternumbercolor}<% endif %>
<% if doxtr_subsection_number_color %>\definecolor{ddsubsectionnumbercolor}{rgb}{<< doxtr_subsection_number_color >>}<% else %>\colorlet{ddsubsectionnumbercolor}{ddsectionnumbercolor}<% endif %>
<% if doxtr_subsubsection_number_color %>\definecolor{ddsubsubsectionnumbercolor}{rgb}{<< doxtr_subsubsection_number_color >>}<% else %>\colorlet{ddsubsubsectionnumbercolor}{ddsubsectionnumbercolor}<% endif %>

%% Apply Universal Fonts, Sizes, and Colors to KOMA-Script Elements
<% if doxtr_title_font or doxtr_title_color or doxtr_title_size %>
\addtokomafont{title}{<% if doxtr_title_color %>\color{ddtitlecolor}<% endif %><% if doxtr_title_size %><< doxtr_title_size >><% endif %><% if doxtr_title_font %>\fontspec{<< doxtr_title_font >>}<% endif %>}
<% endif %>

<% if doxtr_subtitle_font or doxtr_subtitle_color or doxtr_subtitle_size %>
\addtokomafont{subtitle}{<% if doxtr_subtitle_color %>\color{ddsubtitlecolor}<% endif %><% if doxtr_subtitle_size %><< doxtr_subtitle_size >><% endif %><% if doxtr_subtitle_font %>\fontspec{<< doxtr_subtitle_font >>}<% endif %>}
<% endif %>

<% if doxtr_author_font or doxtr_author_color or doxtr_author_size %>
\addtokomafont{author}{<% if doxtr_author_color %>\color{ddauthorcolor}<% endif %><% if doxtr_author_size %><< doxtr_author_size >><% endif %><% if doxtr_author_font %>\fontspec{<< doxtr_author_font >>}<% endif %>}
<% endif %>

<% if doxtr_date_font or doxtr_date_color or doxtr_date_size %>
\addtokomafont{date}{<% if doxtr_date_color %>\color{dddatecolor}<% endif %><% if doxtr_date_size %><< doxtr_date_size >><% endif %><% if doxtr_date_font %>\fontspec{<< doxtr_date_font >>}<% endif %>}
<% endif %>

%% Custom element for Release Version
\newkomafont{releaseversion}{}
<% if doxtr_release_version_font or doxtr_release_version_color or doxtr_release_version_size %>
\addtokomafont{releaseversion}{<% if doxtr_release_version_color %>\color{ddreleaseversioncolor}<% endif %><% if doxtr_release_version_size %><< doxtr_release_version_size >><% endif %><% if doxtr_release_version_font %>\fontspec{<< doxtr_release_version_font >>}<% endif %>}
<% endif %>

<% if doxtr_chapter_font or doxtr_chapter_color or doxtr_chapter_size %>
\addtokomafont{chapter}{<% if doxtr_chapter_color %>\color{ddchaptercolor}<% endif %><% if doxtr_chapter_size %><< doxtr_chapter_size >><% endif %><% if doxtr_chapter_font %>\fontspec{<< doxtr_chapter_font >>}<% endif %>}
<% endif %>

<% if doxtr_section_font or doxtr_section_color or doxtr_section_size %>
\addtokomafont{section}{<% if doxtr_section_color %>\color{ddsectioncolor}<% endif %><% if doxtr_section_size %><< doxtr_section_size >><% endif %><% if doxtr_section_font %>\fontspec{<< doxtr_section_font >>}<% endif %>}
<% endif %>

<% if doxtr_subsection_font or doxtr_subsection_color or doxtr_subsection_size %>
\addtokomafont{subsection}{<% if doxtr_subsection_color %>\color{ddsubsectioncolor}<% endif %><% if doxtr_subsection_size %><< doxtr_subsection_size >><% endif %><% if doxtr_subsection_font %>\fontspec{<< doxtr_subsection_font >>}<% endif %>}
<% endif %>

<% if doxtr_subsubsection_font or doxtr_subsubsection_color or doxtr_subsubsection_size %>
\addtokomafont{subsubsection}{<% if doxtr_subsubsection_color %>\color{ddsubsubsectioncolor}<% endif %><% if doxtr_subsubsection_size %><< doxtr_subsubsection_size >><% endif %><% if doxtr_subsubsection_font %>\fontspec{<< doxtr_subsubsection_font >>}<% endif %>}
<% endif %>

\newkomafont{chapternumber}{}
<% if doxtr_chapter_number_font or doxtr_chapter_number_color or doxtr_chapter_number_size %>
\addtokomafont{chapternumber}{<% if doxtr_chapter_number_color %>\color{ddchapternumbercolor}<% endif %><% if doxtr_chapter_number_size %><< doxtr_chapter_number_size >><% endif %><% if doxtr_chapter_number_font %>\fontspec{<< doxtr_chapter_number_font >>}<% endif %>}
<% endif %>

\newkomafont{sectionnumber}{}
<% if doxtr_section_number_font or doxtr_section_number_color or doxtr_section_number_size %>
\addtokomafont{sectionnumber}{<% if doxtr_section_number_color %>\color{ddsectionnumbercolor}<% endif %><% if doxtr_section_number_size %><< doxtr_section_number_size >><% endif %><% if doxtr_section_number_font %>\fontspec{<< doxtr_section_number_font >>}<% endif %>}
<% endif %>

\newkomafont{subsectionnumber}{}
<% if doxtr_subsection_number_font or doxtr_subsection_number_color or doxtr_subsection_number_size %>
\addtokomafont{subsectionnumber}{<% if doxtr_subsection_number_color %>\color{ddsubsectionnumbercolor}<% endif %><% if doxtr_subsection_number_size %><< doxtr_subsection_number_size >><% endif %><% if doxtr_subsection_number_font %>\fontspec{<< doxtr_subsection_number_font >>}<% endif %>}
<% endif %>

\newkomafont{subsubsectionnumber}{}
<% if doxtr_subsubsection_number_font or doxtr_subsubsection_number_color or doxtr_subsubsection_number_size %>
\addtokomafont{subsubsectionnumber}{<% if doxtr_subsubsection_number_color %>\color{ddsubsubsectionnumbercolor}<% endif %><% if doxtr_subsubsection_number_size %><< doxtr_subsubsection_number_size >><% endif %><% if doxtr_subsubsection_number_font %>\fontspec{<< doxtr_subsubsection_number_font >>}<% endif %>}
<% endif %>

%% Failsafe for lower KOMA hooks to prevent crash if undefined
\newkomafont{paragraphnumber}{}
\newkomafont{subparagraphnumber}{}

%% ----------------------------------------------------
%% SECTION NUMBER X-HEIGHT SCALING (number_match_title_xheight)
%% When enabled, overrides the number font size so its cap height
%% matches the x-height of the title font at that level.
%% Uses \directlua for floating-point arithmetic (LuaLaTeX required).
%% Both measurement and \setkomafont run inside \AtBeginDocument because
%% fontspec fonts are not loaded at preamble time (\settoheight returns 0).
%% \AtBeginDocument fires after all preamble code and before the first
%% heading is typeset, so \setkomafont reliably overrides \addtokomafont.
%% ----------------------------------------------------
<% if doxtr_section_number_match_title_xheight or doxtr_subsection_number_match_title_xheight or doxtr_subsubsection_number_match_title_xheight %>
\makeatletter
\newdimen\doxtr@xhsc@xh
\newdimen\doxtr@xhsc@ch

\AtBeginDocument{%
<% for el in ['section', 'subsection', 'subsubsection'] %>
<% if v['doxtr_' ~ el ~ '_number_match_title_xheight'] %>
  % --- << el | capitalize >>: scale number cap-height to title x-height ---
  \settoheight{\doxtr@xhsc@xh}{{<% if v['doxtr_' ~ el ~ '_size'] %><< v['doxtr_' ~ el ~ '_size'] >><% endif %><% if v['doxtr_' ~ el ~ '_font'] %>\fontspec{<< v['doxtr_' ~ el ~ '_font'] >>}<% endif %>x}}%
  \settoheight{\doxtr@xhsc@ch}{{\fontsize{10pt}{12pt}\selectfont<% if v['doxtr_' ~ el ~ '_number_font'] %>\fontspec{<< v['doxtr_' ~ el ~ '_number_font'] >>}<% endif %>0}}%
  \directlua{
    local xh = \number\doxtr@xhsc@xh
    local ch = \number\doxtr@xhsc@ch
    if ch > 0 then
      local sz = xh / ch * 10
      local bl = sz * 1.2
      sz = math.floor(sz * 100 + 0.5) / 100
      bl = math.floor(bl * 100 + 0.5) / 100
      tex.sprint("\\setkomafont{<< el >>number}{\\color{dd<< el >>numbercolor}\\fontsize{" .. tostring(sz) .. "pt}{" .. tostring(bl) .. "pt}\\selectfont<% if v['doxtr_' ~ el ~ '_number_font'] %>\\fontspec{<< v['doxtr_' ~ el ~ '_number_font'] >>}<% endif %>}")
    end
  }
<% endif %>
<% endfor %>

% --- Paragraph / Subparagraph: inherit x-height scaling from subsubsection ---
<% if doxtr_subsubsection_number_match_title_xheight %>
  \settoheight{\doxtr@xhsc@xh}{{\normalsize\sffamily\bfseries x}}%
  \settoheight{\doxtr@xhsc@ch}{{\fontsize{10pt}{12pt}\selectfont<% if doxtr_subsubsection_number_font %>\fontspec{<< doxtr_subsubsection_number_font >>}<% endif %>0}}%
  \directlua{
    local xh = \number\doxtr@xhsc@xh
    local ch = \number\doxtr@xhsc@ch
    if ch > 0 then
      local sz = xh / ch * 10
      local bl = sz * 1.2
      sz = math.floor(sz * 100 + 0.5) / 100
      bl = math.floor(bl * 100 + 0.5) / 100
      tex.sprint("\\setkomafont{paragraphnumber}{\\color{ddsubsubsectionnumbercolor}\\fontsize{" .. tostring(sz) .. "pt}{" .. tostring(bl) .. "pt}\\selectfont<% if doxtr_subsubsection_number_font %>\\fontspec{<< doxtr_subsubsection_number_font >>}<% endif %>}")
      tex.sprint("\\setkomafont{subparagraphnumber}{\\color{ddsubsubsectionnumbercolor}\\fontsize{" .. tostring(sz) .. "pt}{" .. tostring(bl) .. "pt}\\selectfont<% if doxtr_subsubsection_number_font %>\\fontspec{<< doxtr_subsubsection_number_font >>}<% endif %>}")
    end
  }
  \renewcommand*{\paragraphformat}{\usekomafont{paragraphnumber}\theparagraph\autodot}
  \renewcommand*{\subparagraphformat}{\usekomafont{subparagraphnumber}\thesubparagraph\autodot}
<% endif %>
}% end \AtBeginDocument
\makeatother
<% endif %>

%% Redefine Sphinx Rubric mapping to inject custom styling
<% if doxtr_rubric_font or doxtr_rubric_color or doxtr_rubric_size %>
\makeatletter
\renewcommand{\sphinxrubric}[1]{%
  \subsubsection*{%
    <% if doxtr_rubric_color %>\color{ddrubriccolor}<% endif %>%
    <% if doxtr_rubric_size %><< doxtr_rubric_size >><% endif %>%
    <% if doxtr_rubric_font %>\fontspec{<< doxtr_rubric_font >>}<% endif %>%
    #1%
  }%
}
\makeatother
<% endif %>

%% Hook into Sphinx's title elements to force KOMA font injection onto the Sphinx title page
\makeatletter
\let\orig@title\title

%% The Title is now purely the Title. Subtitles must be handled by the Title Page Template!
\renewcommand{\title}[1]{\orig@title{\texorpdfstring{\usekomafont{title}#1}{#1}}}

\let\orig@author\author
\renewcommand{\author}[1]{\orig@author{\texorpdfstring{\usekomafont{author}#1}{#1}}}

\let\orig@date\date
\renewcommand{\date}[1]{\orig@date{\texorpdfstring{\usekomafont{date}#1}{#1}}}

<% if doxtr_show_release %>
% Sphinx splits the release line into two macros: \releasename ("Release") and \version ("0.0.1").
% We apply the komafont to both so the entire line matches.
\let\orig@release\release
\renewcommand{\release}[1]{\orig@release{\texorpdfstring{\usekomafont{releaseversion}#1}{#1}}}

\AtBeginDocument{
  \@ifundefined{releasename}{}{%
    \let\orig@releasename\releasename
    \renewcommand{\releasename}{\texorpdfstring{\usekomafont{releaseversion}\orig@releasename}{\orig@releasename}}
  }
}
<% else %>
% User disabled the release text entirely for PDF!
\renewcommand{\release}[1]{}
\AtBeginDocument{
  \@ifundefined{releasename}{}{\renewcommand{\releasename}{}}
}
<% endif %>
\makeatother

%% Force KOMA-Script to actively use the split partnumber elements for the "Part X" string.
%% This MUST happen \AtBeginDocument so that Babel/Polyglossia language localizations dont overwrite it!
\makeatletter
\AtBeginDocument{
  \@ifundefined{partformat}{}{%
    \renewcommand*{\partformat}{{\usekomafont{partnumberpart}\partname\nobreakspace}{\usekomafont{partnumbernumber}\thepart\autodot}}
  }
}
\makeatother

%% ----------------------------------------------------
%% DYNAMIC HEADING ALIGNMENT & MARGIN FORMATTING
%% ----------------------------------------------------
\makeatletter

\def\doxtr@drawline#1#2{%
  \smash{\textcolor{#1}{\rule[-1ex]{2pt}{#2}}}%
}

%% Strip KOMA formatting artifacts so we have total layout control
\renewcommand*{\chapterformat}{\usekomafont{chapternumber}\thechapter\autodot}
\renewcommand*{\sectionformat}{\usekomafont{sectionnumber}\thesection\autodot}
\renewcommand*{\subsectionformat}{\usekomafont{subsectionnumber}\thesubsection\autodot}
\renewcommand*{\subsubsectionformat}{\usekomafont{subsubsectionnumber}\thesubsubsection\autodot}

%% --------- CHAPTER ALIGNMENT LOGIC ---------
\def\doxtr@chapter@align@right#1#2#3{%
<% if doxtr_chapter_number_margin %>
  \makebox[\textwidth][r]{%
    \parbox[b]{\dimexpr\textwidth-<< doxtr_chapter_margin_space >>\relax}{\raggedleft\usekomafont{chapter}#3}%
    \hspace{<< doxtr_chapter_margin_space >>}%
    \makebox[0pt][l]{<% if doxtr_chapter_number_line %>\doxtr@drawline{ddchapterlinecolor}{<< doxtr_chapter_line_height >>}<% endif %>\hspace{<< doxtr_chapter_number_sep >>}#2}%
  }%
<% else %>
  \raggedleft\usekomafont{chapter}#2\enskip#3%
<% endif %>
}
\def\doxtr@chapter@align@left#1#2#3{%
<% if doxtr_chapter_number_margin %>
  \makebox[\textwidth][l]{%
    \makebox[0pt][r]{#2\hspace{<< doxtr_chapter_number_sep >>}<% if doxtr_chapter_number_line %>\doxtr@drawline{ddchapterlinecolor}{<< doxtr_chapter_line_height >>}<% endif %>}%
    \hspace{<< doxtr_chapter_margin_space >>}%
    \parbox[b]{\dimexpr\textwidth-<< doxtr_chapter_margin_space >>\relax}{\raggedright\usekomafont{chapter}#3}%
  }%
<% else %>
  \raggedright\usekomafont{chapter}#2\enskip#3%
<% endif %>
}
\def\doxtr@chapter@align@alternate#1#2#3{\Ifthispageodd{\doxtr@chapter@align@right{#1}{#2}{#3}}{\doxtr@chapter@align@left{#1}{#2}{#3}}}

<% if doxtr_chapter_align == 'left' %>
  \renewcommand*\chapterlinesformat[3]{\Ifstr{#1}{chapter}{\doxtr@chapter@align@left{#1}{#2}{#3}}{\@hangfrom{#2}{#3}}}
<% elif doxtr_chapter_align == 'right' %>
  \renewcommand*\chapterlinesformat[3]{\Ifstr{#1}{chapter}{\doxtr@chapter@align@right{#1}{#2}{#3}}{\@hangfrom{#2}{#3}}}
<% else %>
  \renewcommand*\chapterlinesformat[3]{\Ifstr{#1}{chapter}{\doxtr@chapter@align@alternate{#1}{#2}{#3}}{\@hangfrom{#2}{#3}}}
<% endif %>

%% --------- SECTION ALIGNMENT LOGIC ---------
<% for el in ['section', 'subsection', 'subsubsection'] %>

  <% if v['doxtr_' ~ el ~ '_line_color'] %>
    \definecolor{dd<< el >>linecolor}{rgb}{<< v['doxtr_' ~ el ~ '_line_color'] >>}
  <% else %>
    \colorlet{dd<< el >>linecolor}{dd<< el >>numbercolor!45}
  <% endif %>

  \def\doxtr@<< el >>@align@right#1#2#3#4{%
  <% if v['doxtr_' ~ el ~ '_number_margin'] %>
    \makebox[\textwidth][r]{%
      \parbox[b]{\dimexpr\textwidth-<< v['doxtr_' ~ el ~ '_margin_space'] >>\relax}{\raggedleft\usekomafont{#1}#4}%
      \hspace{<< v['doxtr_' ~ el ~ '_margin_space'] >>}%
      \makebox[0pt][l]{<% if v['doxtr_' ~ el ~ '_number_line'] %>\doxtr@drawline{dd<< el >>linecolor}{<< v['doxtr_' ~ el ~ '_line_height'] >>}<% endif %>\hspace{<< v['doxtr_' ~ el ~ '_number_sep'] >>}#3}%
    }%
  <% else %>
    \raggedleft #3\enskip#4%
  <% endif %>
  }
  
  \def\doxtr@<< el >>@align@left#1#2#3#4{%
  <% if v['doxtr_' ~ el ~ '_number_margin'] %>
    \makebox[\textwidth][l]{%
      \makebox[0pt][r]{#3\hspace{<< v['doxtr_' ~ el ~ '_number_sep'] >>}<% if v['doxtr_' ~ el ~ '_number_line'] %>\doxtr@drawline{dd<< el >>linecolor}{<< v['doxtr_' ~ el ~ '_line_height'] >>}<% endif %>}%
      \hspace{<< v['doxtr_' ~ el ~ '_margin_space'] >>}%
      \parbox[b]{\dimexpr\textwidth-<< v['doxtr_' ~ el ~ '_margin_space'] >>\relax}{\raggedright\usekomafont{#1}#4}%
    }%
  <% else %>
    \raggedright #3\enskip#4%
  <% endif %>
  }
  
  \def\doxtr@<< el >>@align@alternate#1#2#3#4{\Ifthispageodd{\doxtr@<< el >>@align@right{#1}{#2}{#3}{#4}}{\doxtr@<< el >>@align@left{#1}{#2}{#3}{#4}}}

  <% if v['doxtr_' ~ el ~ '_align'] == 'left' %>
    \expandafter\def\csname doxtr@align@<< el >>\endcsname{\doxtr@<< el >>@align@left}
  <% elif v['doxtr_' ~ el ~ '_align'] == 'right' %>
    \expandafter\def\csname doxtr@align@<< el >>\endcsname{\doxtr@<< el >>@align@right}
  <% else %>
    \expandafter\def\csname doxtr@align@<< el >>\endcsname{\doxtr@<< el >>@align@alternate}
  <% endif %>

<% endfor %>

\KOMAoption{numbers}{noendperiod}

%% ----------------------------------------------------
%% FIX: Ensure TOC numbering width accommodates deep nesting
%% e.g., "B.4.21 Threat" — the number "B.4.21" must not
%% overlap with the section name.
%% Use KOMA-Script's dynamic width feature so the TOC
%% automatically expands to fit the widest number.
%% ----------------------------------------------------
%% Enable dynamic numwidth for ALL levels (prevents number/title overlap in deep nesting)
\RedeclareSectionCommands[tocdynnumwidth]{chapter,section,subsection,subsubsection}
%% Enable dynamic indent only for levels that have a parent (chapter has indent=0, no parent)
\RedeclareSectionCommands[tocdynindent]{section,subsection,subsubsection}
\renewcommand\sectionlinesformat[4]{%
  \needspace{.05\textheight}%
  \@ifundefined{doxtr@align@#1}{%
    \@hangfrom{#3}{#4}%
  }{%
    \@nameuse{doxtr@align@#1}{#1}{#2}{#3}{#4}%
  }%
}
\makeatother

%%% Style chapters

% Map Sphinx's "normal" style to "scrheadings" to prevent crashes
\makeatletter
\let\ps@normal\ps@scrheadings
\makeatother

% Fix Arrow in menuselection commands, as some fonts cannot handle that
% 1. Define a helper to split the string at the '‣' character
\makeatletter
\def\my@menu@split#1‣#2\@nil{%
  \if\relax\detokenize{#2}\relax
    #1% No more arrows found
  \else
    #1 \ensuremath{\rightarrow} \my@menu@split#2\@nil
  \fi
}

% 2. Redefine the Sphinx menu selection command
\DeclareRobustCommand{\sphinxmenuselection}[1]{%
  \textsf{\textit{\my@menu@split#1‣\@nil}}%
}
\makeatother


%% ----------------------------------------------------
%% DYNAMIC CAPTION ROUTER (FIGURES VS TABLES)
%% ----------------------------------------------------
\makeatletter
\let\dd@orig@makecaption\@makecaption
\long\def\@makecaption#1#2{%
    \def\dd@temp@type{\@captype}%
    \def\dd@type@table{table}%
    \def\dd@type@figure{figure}%
    \ifx\dd@temp@type\dd@type@table
        \@ifundefined{dd@makecaption@table}{%
            \dd@orig@makecaption{#1}{#2}%
        }{%
            \dd@makecaption@table{#1}{#2}%
        }%
    \else\ifx\dd@temp@type\dd@type@figure
        \@ifundefined{dd@makecaption@figure}{%
            \dd@orig@makecaption{#1}{#2}%
        }{%
            \dd@makecaption@figure{#1}{#2}%
        }%
    \else
        \dd@orig@makecaption{#1}{#2}%
    \fi\fi
}
\makeatother


%% ----------------------------------------------------
%% DYNAMIC SPHINX ADMONITION ROUTER
%% ----------------------------------------------------

%% 1. Register generated colors and fonts
<% for t in admon_types %>
  \definecolor{ddadmon@<< t >>@titlebg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_title_background_color_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@iconboxbg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_title_icon_box_background_color_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@contentbg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_content_background_color_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@contentbgnested}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_content_background_color_nested_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@titlefg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_title_font_color_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@contentfg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_content_font_color_cmyk'] >>}
  \definecolor{ddadmon@<< t >>@iconfg}{rgb}{<< v['doxtr_admonition_' ~ t ~ '_title_icon_color_cmyk'] >>}

  \expandafter\def\csname ddadmon@<< t >>@titlefont\endcsname{<% if v['doxtr_admonition_' ~ t ~ '_title_font'] %>\fontspec{<< v['doxtr_admonition_' ~ t ~ '_title_font'] >>}<% endif %><< v['doxtr_admonition_' ~ t ~ '_title_font_size'] >>}
  \expandafter\def\csname ddadmon@<< t >>@contentfont\endcsname{<% if v['doxtr_admonition_' ~ t ~ '_content_font'] %>\fontspec{<< v['doxtr_admonition_' ~ t ~ '_content_font'] >>}<% endif %><< v['doxtr_admonition_' ~ t ~ '_content_font_size'] >>}
  \expandafter\def\csname ddadmon@<< t >>@iconsize\endcsname{<< v['doxtr_admonition_' ~ t ~ '_title_icon_size'] >>}
  \expandafter\def\csname ddadmon@<< t >>@icon\endcsname{<< v['doxtr_admonition_' ~ t ~ '_title_icon'] >>}
  \expandafter\def\csname ddadmon@<< t >>@iconpad\endcsname{<< v['doxtr_admonition_' ~ t ~ '_title_icon_padding'] >>}
  \expandafter\def\csname ddadmon@<< t >>@decospace\endcsname{<< v['doxtr_admonition_' ~ t ~ '_title_decoration_spacing'] >>}
  \expandafter\def\csname ddadmon@<< t >>@beforeskip\endcsname{<< v['doxtr_admonition_' ~ t ~ '_before_skip'] >>}
  \expandafter\def\csname ddadmon@<< t >>@afterskip\endcsname{<< v['doxtr_admonition_' ~ t ~ '_after_skip'] >>}
<% endfor %>

\makeatletter
%% 2. Define the reusable Admonition environments (Users define \newenvironment{ddadmonbox@stylename}[2])
<% for style_name, style_content in doxtr_loaded_admon_styles.items() %>
<< style_content >>
<% endfor %>

%% 3. Map admonition types to their assigned structural styles
<% for t in admon_types %>
\expandafter\def\csname ddadmonstylemap@<< t >>\endcsname{<< doxtr_admon_styles_map[t] >>}
<% endfor %>

%% 4. Hook into Sphinx's master admonition macro with a Dynamic Environment Router
\newenvironment{doxtradmonboxrouter}[2]{%
    \doxtr@cap@breakable@pagegoal
    \def\myadmontype{#1}%
    \@ifundefined{ddadmonstylemap@\myadmontype}{\def\myadmontype{generic}}{}%
    % Look up the structural geometry mapped to this admonition type
    \edef\mystyle{\csname ddadmonstylemap@\myadmontype\endcsname}%
    % Dynamically save the correct \end{...} command
    \edef\endrouter{\noexpand\end{ddadmonbox@\mystyle}}%
    % Forcefully expand the style and type strings BEFORE starting the environment
    % to protect the variables from dying during tcolorbox rendering!
    \begingroup\edef\x{\endgroup\noexpand\begin{ddadmonbox@\mystyle}{\myadmontype}}\x{#2}%
}{%
    \endrouter
}

\renewenvironment{sphinxadmonition}[2]{%
    \begin{doxtradmonboxrouter}{#1}{#2}%
}{%
  \end{doxtradmonboxrouter}%
}

%% Hook into Sphinx's type-specific admonition environments that bypass sphinxadmonition
%% (e.g., 'seealso' uses its own 'sphinxseealso' environment instead of 'sphinxadmonition')
\renewenvironment{sphinxseealso}[1]{%
    \begin{doxtradmonboxrouter}{seealso}{#1}%
}{%
  \end{doxtradmonboxrouter}%
}
\makeatother


%% ----------------------------------------------------
%% DYNAMIC TCOLORBOX CONTAINERS (STYLEBOX)
%% ----------------------------------------------------

<% if doxtr_loaded_title_styles %>
\makeatletter
\tcbset{<% for style_name, style_content in doxtr_loaded_title_styles.items() %>doxtr<< style_name >>style/.style={<< style_content >>}<% if not loop.last %>,<% endif %><% endfor %>}
\makeatother
<% endif %>

<% if doxtr_rendered_containers %>
\makeatletter
<% for container_tex in doxtr_rendered_containers %>
<< container_tex >>
<% endfor %>
\makeatother
<% endif %>

%% ----------------------------------------------------
%% DYNAMIC TABLES
%% ----------------------------------------------------
<% if doxtr_rendered_tables %>
<< doxtr_rendered_tables >>
<% endif %>


%% ----------------------------------------------------
%% DYNAMIC FIGURES
%% ----------------------------------------------------
<% if doxtr_rendered_figures %>
<< doxtr_rendered_figures >>
<% endif %>


%% ----------------------------------------------------
%% DYNAMIC SPHINX-NEEDS STYLING
%% ----------------------------------------------------
<% if 'sphinx_needs' in extensions %>
\makeatletter

%% 1. Register generated colors and fonts
<% for t in need_types %>
  \definecolor{ddneed@<< t >>@titlebg}{rgb}{<< v['doxtr_need_' ~ t ~ '_title_background_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@titlefg}{rgb}{<< v['doxtr_need_' ~ t ~ '_title_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@iconfg}{rgb}{<< v['doxtr_need_' ~ t ~ '_title_icon_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@metabg}{rgb}{<< v['doxtr_need_' ~ t ~ '_metadata_background_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@metafg}{rgb}{<< v['doxtr_need_' ~ t ~ '_metadata_font_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@metakeyfg}{rgb}{<< v['doxtr_need_' ~ t ~ '_metadata_key_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@contentbg}{rgb}{<< v['doxtr_need_' ~ t ~ '_content_background_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@contentfg}{rgb}{<< v['doxtr_need_' ~ t ~ '_content_font_color_cmyk'] >>}
  \definecolor{ddneed@<< t >>@seglinefg}{rgb}{<< v['doxtr_need_' ~ t ~ '_segmentation_color_cmyk'] >>}

  \expandafter\def\csname ddneed@<< t >>@titlefont\endcsname{<% if v['doxtr_need_' ~ t ~ '_title_font'] %>\fontspec{<< v['doxtr_need_' ~ t ~ '_title_font'] >>}<% endif %><< v['doxtr_need_' ~ t ~ '_title_font_size'] >>}
  \expandafter\def\csname ddneed@<< t >>@metafont\endcsname{<% if v['doxtr_need_' ~ t ~ '_metadata_font'] %>\fontspec{<< v['doxtr_need_' ~ t ~ '_metadata_font'] >>}<% endif %><< v['doxtr_need_' ~ t ~ '_metadata_font_size'] >>}
  \expandafter\def\csname ddneed@<< t >>@metakeyfont\endcsname{<% if v['doxtr_need_' ~ t ~ '_metadata_key_font'] %>\fontspec{<< v['doxtr_need_' ~ t ~ '_metadata_key_font'] >>}<% endif %><< v['doxtr_need_' ~ t ~ '_metadata_key_font_size'] >>\color{ddneed@<< t >>@metakeyfg}\bfseries}
  \expandafter\def\csname ddneed@<< t >>@contentfont\endcsname{<% if v['doxtr_need_' ~ t ~ '_content_font'] %>\fontspec{<< v['doxtr_need_' ~ t ~ '_content_font'] >>}<% endif %><< v['doxtr_need_' ~ t ~ '_content_font_size'] >>}
  
  \expandafter\def\csname ddneed@<< t >>@iconcmd\endcsname{<% if v['doxtr_need_' ~ t ~ '_title_icon'] %>\raisebox{<< v['doxtr_need_' ~ t ~ '_icon_raise_math'] >>}{{<< v['doxtr_need_' ~ t ~ '_title_icon_size'] >>\color{ddneed@<< t >>@iconfg}<< v['doxtr_need_' ~ t ~ '_title_icon'] >>}}\hspace{0.5em}<% endif %>}
  \expandafter\def\csname ddneed@<< t >>@beforeskip\endcsname{<< v['doxtr_need_' ~ t ~ '_before_skip'] >>}
  \expandafter\def\csname ddneed@<< t >>@afterskip\endcsname{<< v['doxtr_need_' ~ t ~ '_after_skip'] >>}
  \expandafter\def\csname ddneed@<< t >>@segstyle\endcsname{<< v['doxtr_need_' ~ t ~ '_segmentation_style'] >>}
<% endfor %>

%% 2. Load custom need templates
<% for style_name, style_content in doxtr_loaded_need_styles.items() %>
<< style_content >>
<% endfor %>

%% 3. Map need types to their assigned structural styles
<% for t in need_types %>
\expandafter\def\csname ddneedstylemap@<< t >>\endcsname{<< doxtr_need_styles_map[t] >>}
<% endfor %>

%% Abstracted so alternative need templates can redefine this command
%% without requiring changes to the AST processor (needs.py).
\newcommand{\doxtrneedcontentsep}{\tcblower}

%% 4. The Dynamic Needs Router
\newenvironment{doxtrneedboxrouter}[2]{%
    \doxtr@cap@breakable@pagegoal
    \def\myneedtype{#1}%
    \@ifundefined{ddneedstylemap@\myneedtype}{\def\myneedtype{generic}}{}%
    \edef\mystyle{\csname ddneedstylemap@\myneedtype\endcsname}%
    \edef\endrouter{\noexpand\end{ddneedbox@\mystyle}}%
    % Override \needsmetakey locally so the Sphinx-Needs inner content uses the exact fonts for this type!
    \def\needsmetakey##1{{\csname ddneed@\myneedtype @metakeyfont\endcsname ##1}}%
    \begingroup\edef\x{\endgroup\noexpand\begin{ddneedbox@\mystyle}{\myneedtype}}\x{#2}%
}{%
    \endrouter
}

\makeatother
<% endif %>